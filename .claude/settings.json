{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git tag *)",
      "Bash(git push *--tags*)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push *--delete*)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push *--force*)"
    ]
  }
}
