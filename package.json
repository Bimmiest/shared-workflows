{
  "name": "@bimmiest/shared-workflows",
  "version": "1.13.0",
  "private": true,
  "description": "Reusable GitHub Actions workflows and composite actions: the CI gates shared across Bimmiest repositories.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bimmiest/shared-workflows.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test '.github/actions/**/*.test.mjs'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='.github/actions/**/*.mjs' --test-coverage-exclude='**/*.test.mjs' --test-coverage-lines=97 --test-coverage-branches=94 --test-coverage-functions=97 '.github/actions/**/*.test.mjs'"
  },
  "bin": {
    "audit-check": ".github/actions/audit-check/audit-check.mjs",
    "baseline-check": ".github/actions/baseline-check/baseline-check.mjs",
    "changelog-check": ".github/actions/changelog-check/changelog-check.mjs",
    "coverage-ratchet": ".github/actions/coverage-ratchet/ratchet.mjs",
    "dependabot-review": ".github/actions/dependabot-review/review.mjs",
    "dependabot-review-facts": ".github/actions/dependabot-review-facts/facts.mjs",
    "docs-check": ".github/actions/docs-check/docs-check.mjs",
    "licence-check": ".github/actions/licence-check/licence-check.mjs",
    "lint-allowlist-check": ".github/actions/lint-allowlist-check/lint-allowlist-check.mjs",
    "lockfile-nesting-check": ".github/actions/lockfile-nesting-check/lockfile-nesting.mjs",
    "mutation-ratchet": ".github/actions/mutation-ratchet/ratchet.mjs",
    "node-patch-check": ".github/actions/node-patch-check/node-patch.mjs",
    "node-version-check": ".github/actions/node-version-check/node-version.mjs",
    "package-contents-check": ".github/actions/package-contents-check/package-contents-check.mjs",
    "pr-hygiene": ".github/actions/pr-hygiene/pr-hygiene.mjs",
    "repo-settings-check": ".github/actions/repo-settings-check/repo-settings-check.mjs"
  }
}
